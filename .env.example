# Local demo values only; never use these in production.
DATABASE_URL=postgresql://chat_demo:demo_database_only@localhost:5434/chat_demo
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
COOKIE_SECURE=false
UPLOADS_ENABLED=true
NEXT_PUBLIC_UPLOADS_ENABLED=true
NEXT_PUBLIC_DEMO_MODE=true
# Render supplies PORT automatically; it takes priority over API_PORT.
# EDGE_PROXY_SECRET is required only when using the Cloudflare gateway.
SESSION_DAYS=7
S3_ENDPOINT=http://localhost:9000
# Optional browser-reachable endpoint for signed downloads:
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chat-demo
S3_ACCESS_KEY=demo_storage
S3_SECRET_KEY=demo_storage_only
S3_FORCE_PATH_STYLE=true
# Integration tests require a separate database and Redis logical database.
TEST_DATABASE_URL=postgresql://chat_demo:demo_database_only@localhost:5434/chat_test
TEST_REDIS_URL=redis://localhost:6380/1
